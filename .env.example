# CipherVault — plantilla de configuración. Copia este archivo como .env y rellénalo.
# El .env real NUNCA se sube a git ni se distribuye. Aquí solo van marcadores.

# ── Links de pago fijos de Wompi (reutilizables: single_use=false) ──
# Un link por opción de Premium (todas activan el plan "premium"; cambia la duración).
CIPHERVAULT_WOMPI_LINK_MAP={"premium_mensual":"https://checkout.wompi.co/l/KepI4g","premium_anual":"https://checkout.wompi.co/l/I75Zba","premium_vida":"https://checkout.wompi.co/l/nfKj8q","equipo_3":"https://checkout.wompi.co/l/eBC1hf","equipo_5":"https://checkout.wompi.co/l/5znGkS","equipo_10":"https://checkout.wompi.co/l/wnQAUN","equipo_ilimitado":"https://checkout.wompi.co/l/bwpwwK"}

# ── Servicio de activación (webhook de Make "Canje", ver GUIA_ACTIVACION_MAKE.md) ──
CIPHERVAULT_ACTIVATION_URL=https://hook.us2.make.com/TU_WEBHOOK_DE_CANJE
# Secreto largo y aleatorio, el MISMO que pones en Make para firmar las respuestas.
CIPHERVAULT_ACTIVATION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# ── Precios mostrados en la pantalla de planes (pesos COP, solo informativos) ──
CIPHERVAULT_PRICE_PREMIUM_MENSUAL_COP=9900
CIPHERVAULT_PRICE_PREMIUM_ANUAL_COP=89900
CIPHERVAULT_PRICE_PREMIUM_VIDA_COP=149900
CIPHERVAULT_PRICE_EQUIPO_3_COP=24900
CIPHERVAULT_PRICE_EQUIPO_5_COP=37900
CIPHERVAULT_PRICE_EQUIPO_10_COP=64900
CIPHERVAULT_PRICE_EQUIPO_ILIMITADO_COP=199900


# ── Firma de código del .exe y del instalador (opcional, solo la usa build.ps1) ──
# Nunca se empaqueta dentro del .exe. Usa UNA de las dos opciones:
# CIPHERVAULT_SIGN_THUMBPRINT=HUELLA_SHA1_DEL_CERTIFICADO_INSTALADO
# CIPHERVAULT_SIGN_PFX=C:\ruta\a\certificado.pfx
# CIPHERVAULT_SIGN_PFX_PASSWORD=contraseña_del_pfx

# ── Modo desarrollador: SOLO al ejecutar desde código fuente (run.ps1). ──
# Nunca se lee dentro del .exe y build.ps1 no lo copia al build.
CIPHERVAULT_ENABLE_DEV_TOOLS=0
# CIPHERVAULT_DEV_HOSTNAMES=NOMBRE_DE_TU_PC
# CIPHERVAULT_DEV_USERNAME=tu_usuario_dev
# CIPHERVAULT_DEV_PASSWORD=una_contraseña_de_al_menos_12_caracteres
